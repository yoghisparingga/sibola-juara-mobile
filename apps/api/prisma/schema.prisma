generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Membership {
  free
  pro
  premium
}

enum BookingStatus {
  confirmed
  pending
  cancelled
  completed
}

enum PaymentStatus {
  paid
  pending
  failed
  refunded
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  avatarUrl    String?
  membership   Membership @default(free)
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings Booking[]
  teams    TeamMember[]
}

model Field {
  id            String  @id @default(cuid())
  name          String
  address       String
  distanceKm    Float
  rating        Float   @default(0)
  reviews       Int     @default(0)
  pricePerHour  Int
  imageUrl      String
  facilities    String  @db.Text
  openHour      String
  closeHour     String
  isOpen        Boolean @default(true)
  latitude      Float
  longitude     Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        TeamMember[]
  homeBookings   Booking[]    @relation("HomeTeam")
  awayBookings   Booking[]    @relation("AwayTeam")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String
  role   String @default("member")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  fieldId       String
  date          DateTime
  startTime     String
  endTime       String
  durationHours Int
  price         Int
  serviceFee    Int           @default(0)
  discount      Int           @default(0)
  total         Int
  status        BookingStatus @default(pending)
  payment       PaymentStatus @default(pending)
  paymentMethod String?
  homeTeamId    String?
  awayTeamId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User    @relation(fields: [userId], references: [id])
  field    Field   @relation(fields: [fieldId], references: [id])
  homeTeam Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@index([userId])
  @@index([fieldId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}
